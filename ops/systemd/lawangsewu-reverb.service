[Unit]
Description=Lawangsewu Laravel Reverb Server
After=network.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/lawangsewu
Environment=APP_ENV=production
ExecStart=/usr/bin/php -d memory_limit=384M artisan reverb:start --host=0.0.0.0 --port=8080 --no-interaction
ExecReload=/usr/bin/php artisan reverb:restart
Restart=on-failure
RestartSec=15
KillSignal=SIGTERM
TimeoutStopSec=30
KillMode=mixed
MemoryMax=512M
MemoryHigh=448M
TasksMax=128
Nice=5

[Install]
WantedBy=multi-user.target
