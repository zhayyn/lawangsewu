APP_NAME="Lawangsewu V2"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Jakarta
APP_URL=http://localhost

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
LOG_SLOW_CHANNEL=slow_request
LOG_SLOW_LEVEL=warning
LOG_SLOW_THRESHOLD_MS=500

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ============================================================================
# RATE LIMITING & SECURITY (Added April 2026)
# ============================================================================

# API Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_CACHE=redis
RATE_LIMIT_WINDOW_SECONDS=60

# WA Webhook Security
WA_WEBHOOK_TOKEN=your-secure-webhook-token-here
WA_WEBHOOK_SECRET=your-webhook-secret-key-here
WA_WEBHOOK_IP_WHITELIST=127.0.0.1,192.168.88.0/24
WA_WEBHOOK_RATE_LIMIT_PHONE=100
WA_WEBHOOK_RATE_LIMIT_IP=500

# Database Optimization
DATABASE_OPTIMIZATION_CACHE_ENABLED=true
DATABASE_OPTIMIZATION_CACHE_MINUTES=60

# Queue Monitoring
QUEUE_MONITORING_ENABLED=true
QUEUE_MAX_RETRIES=3
QUEUE_FAILED_JOB_CLEANUP_DAYS=30

# ============================================================================
# OBSERVABILITY & MONITORING (Added April 2026)
# ============================================================================

# Distributed Tracing
TRACING_ENABLED=true
TRACING_SERVICE_NAME=lawangsewu
TRACING_ENVIRONMENT=local
JAEGER_AGENT_HOST=localhost
JAEGER_AGENT_PORT=6831
JAEGER_SAMPLER_TYPE=const
JAEGER_SAMPLER_PARAM=1.0

# Prometheus Metrics
PROMETHEUS_ENABLED=true
PROMETHEUS_PUSH_GATEWAY_URL=http://localhost:9091
PROMETHEUS_SCRAPE_INTERVAL=60

# Error Tracking (Sentry)
SENTRY_ENABLED=false
SENTRY_LARAVEL_DSN=
SENTRY_ENVIRONMENT=local
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.1

# Google Analytics 4 (Website Visitor Tracking)
GOOGLE_ANALYTICS_ID=

# Request Logging
REQUEST_LOGGING_ENABLED=true
REQUEST_LOGGING_HEADERS=true
REQUEST_LOGGING_BODY=true
REQUEST_LOGGING_RESPONSE=false

# Performance Monitoring
SLOW_REQUEST_THRESHOLD_MS=500
SLOW_QUERY_THRESHOLD_MS=1000
SLOW_SIPP_QUERY_THRESHOLD_MS=500
ALERT_ON_SLOW_REQUESTS=false

# Health Checks
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_DATABASE=true
HEALTH_CHECK_CACHE=true
HEALTH_CHECK_QUEUE=true
HEALTH_CHECK_EXTERNAL=true

# Alerting
ALERTS_ENABLED=false
SLACK_ALERTS_ENABLED=false
SLACK_ALERT_WEBHOOK_URL=
EMAIL_ALERTS_ENABLED=false
ALERT_EMAIL_RECIPIENTS=admin@example.com
PAGERDUTY_ALERTS_ENABLED=false
PAGERDUTY_INTEGRATION_KEY=

# Alert Thresholds
ALERT_ERROR_RATE_THRESHOLD=5.0
ALERT_QUEUE_DEPTH=1000
ALERT_DB_POOL_THRESHOLD=0.8
ALERT_RESPONSE_TIME_MS=1000

# Data Retention
METRICS_RETENTION_DAYS=30
LOGS_RETENTION_DAYS=30
TRACES_RETENTION_DAYS=7
ERRORS_RETENTION_DAYS=90

# ============================================================================
# SECURITY & COMPLIANCE (Updated April 2026)
# ============================================================================

# CORS Configuration
CORS_ENABLED=true
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,https://lawangsewu.app
CORS_DEFAULT_ORIGIN=https://lawangsewu.app

# Encryption
FIELD_ENCRYPTION_ENABLED=true
API_ENCRYPTION_ENABLED=false

# Authentication & Authorization
SESSION_TIMEOUT_MINUTES=120
PASSWORD_EXPIRATION_DAYS=90
MFA_ENABLED=true

# OAuth 2.0 (Google)
OAUTH_ENABLED=true
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://lawangsewu.app/auth/google/callback

# API Security
VALIDATE_API_KEY=true
VERIFY_REQUEST_SIGNATURE=false
IP_WHITELIST_ENABLED=false
IP_WHITELIST=127.0.0.1

# Input Validation
MAX_FILE_SIZE_MB=10
SCAN_UPLOADS_FOR_MALWARE=false

# Audit & Compliance
AUDIT_LOG_RETENTION_DAYS=365
GDPR_COMPLIANCE=true
USER_ACTIVITY_LOG_RETENTION_DAYS=90
API_LOG_RETENTION_DAYS=30
ERROR_LOG_RETENTION_DAYS=90

# Headers & Security Policies
HTTPS_STRICT=true
ENABLE_SECURITY_TESTING=false

# Webhook Security (Updated)
WEBHOOK_TRUSTED_IPS=127.0.0.1
WEBHOOK_RATE_LIMIT_IP=500
WEBHOOK_RATE_LIMIT_PHONE=100

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Laravel Reverb (WebSocket Real-time)
REVERB_APP_ID=lawangsewu
REVERB_APP_KEY=lawangsewu-reverb-key
REVERB_APP_SECRET=lawangsewu-reverb-secret
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# ============================================================
# WA CARAKA CONFIGURATION
# ============================================================
# WhatsApp messaging system via Baileys runtime
WA_CARAKA_ENABLED=true
LW_WA_V2_BASE=http://127.0.0.1:8790
LW_WA_V2_TOKEN=your-shared-secret-token-here
LW_WA_V2_TIMEOUT=20
LW_WA_V2_BROADCAST_LIMIT=50
WA_CARAKA_DB_CONNECTION=mysql
# WA_CARAKA_DB_DRIVER=mysql
# WA_CARAKA_DB_HOST=127.0.0.1
# WA_CARAKA_DB_PORT=3306
# WA_CARAKA_DB_DATABASE=lawangsewu_wa
# WA_CARAKA_DB_USERNAME=root
# WA_CARAKA_DB_PASSWORD=
# WA_CARAKA_DB_SOCKET=
WA_HISTORY_SYNC_MAX_DAYS=45
WA_HISTORY_SYNC_BATCH_SIZE=75

# ============================================================
# SIPP CONFIGURATION
# ============================================================
# SIPP (Sistem Informasi Pertanggungjawaban Perkara) integration
SIPP_ENABLED=true
SIPP_DB_HOST=192.168.88.10
SIPP_DB_PORT=3306
SIPP_DB_DATABASE=sipp
SIPP_DB_USERNAME=admin
SIPP_DB_PASSWORD=your-sipp-password
SIPP_DB_TIMEOUT=5
SIPP_CACHE_TTL=15

# ============================================================
# HEALTH CHECK CONFIGURATION
# ============================================================
HEALTH_CHECK_ENABLED=true

# ============================================================
# FEATURE FLAGS
# ============================================================
# Control which features are enabled
FEATURE_WA_CARAKA=true
FEATURE_SIPP_HUB=true
FEATURE_PILAR=true
FEATURE_GUESTBOOK=true
FEATURE_CHAT=true
VITE_REVERB_ENABLED=true

# ──────────────────────────────────────────────────────────
# WA Caraka Module (WhatsApp Gateway)
# ──────────────────────────────────────────────────────────
# Base URL of the Node.js WA runtime process
LW_WA_V2_BASE=http://127.0.0.1:8790
# Static API token for runtime authentication (optional)
LW_WA_V2_TOKEN=
# HTTP timeout for runtime calls (seconds)
LW_WA_V2_TIMEOUT=20
# Max recipients per broadcast
LW_WA_BROADCAST_LIMIT=50
# Enable local message logging to wa_caraka_logs table
LW_WA_LOGGING=true
# Dedicated DB target for WA Caraka tables
WA_CARAKA_DB_CONNECTION=mysql
# WA_CARAKA_DB_DATABASE=lawangsewu_wa
# WA_CARAKA_DB_USERNAME=root
# WA_CARAKA_DB_PASSWORD=
# Tuning for smoother first login / history sync
WA_HISTORY_SYNC_MAX_DAYS=45
WA_HISTORY_SYNC_BATCH_SIZE=75

# Widget Embed Security
# ──────────────────────────────────────────────────────────
# Daftar domain yang diizinkan untuk embed widget via iframe (spasi sebagai separator).
# Jika tidak diset, menggunakan default: pa-semarang.go.id, www.pa-semarang.go.id, dan localhost.
# Contoh: WIDGET_EMBED_ORIGINS="https://pa-semarang.go.id https://portal.mahkamahagung.go.id"
WIDGET_EMBED_ORIGINS=
