# ═══════════════════════════════════════════════════════════════════════════
# .env.docker — Template konfigurasi untuk deployment Docker Lawangsewu
#
# CARA PAKAI:
#   cp .env.docker .env
#   nano .env  ← sesuaikan nilai yang ditandai [WAJIB DIUBAH]
# ═══════════════════════════════════════════════════════════════════════════

# ── Aplikasi ────────────────────────────────────────────────────────────────
APP_NAME=Lawangsewu
APP_ENV=production
APP_KEY=                          # [WAJIB] Generate: docker compose exec app php artisan key:generate
APP_DEBUG=false
APP_URL=https://localhost          # [WAJIB] Ganti dengan domain instansi (mis: https://lawangsewu.go.id)
APP_DOMAIN=localhost               # [WAJIB] Domain/IP untuk Caddy (mis: lawangsewu.go.id)
TLS_EMAIL=internal                 # [OPSIONAL] Email Let's Encrypt (kosongkan/internal = self-signed)

# ── Locale ──────────────────────────────────────────────────────────────────
APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

# ── Logging ─────────────────────────────────────────────────────────────────
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

# ── Database (MariaDB via Docker) ────────────────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=db                         # ← nama service Docker, JANGAN DIUBAH
DB_PORT=3306
DB_DATABASE=lawangsewu             # [WAJIB] Nama database
DB_USERNAME=lawangsewu             # [WAJIB] Username database
DB_PASSWORD=changeme               # [WAJIB DIUBAH] Password database
DB_ROOT_PASSWORD=changeme_root     # [WAJIB DIUBAH] Password root MariaDB
DB_SOCKET=                         # ← kosong di Docker, pakai TCP

# ── Cache & Session ──────────────────────────────────────────────────────────
CACHE_STORE=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true

# ── Redis (via Docker) ────────────────────────────────────────────────────────
REDIS_CLIENT=phpredis
REDIS_HOST=redis                   # ← nama service Docker, JANGAN DIUBAH
REDIS_PORT=6379
REDIS_PASSWORD=null

# ── Queue ─────────────────────────────────────────────────────────────────────
QUEUE_CONNECTION=redis

# ── Mail ──────────────────────────────────────────────────────────────────────
MAIL_MAILER=smtp
MAIL_HOST=smtp.example.com         # [WAJIB] SMTP server instansi
MAIL_PORT=587
MAIL_USERNAME=                     # [WAJIB] Username SMTP
MAIL_PASSWORD=                     # [WAJIB] Password SMTP
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@example.go.id  # [WAJIB]
MAIL_FROM_NAME="${APP_NAME}"

# ── Reverb WebSocket ──────────────────────────────────────────────────────────
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=lawangsewu
REVERB_APP_KEY=lawangsewu
REVERB_APP_SECRET=changeme         # [WAJIB DIUBAH]
REVERB_HOST=localhost              # [WAJIB] Domain instansi
REVERB_PORT=443
REVERB_SCHEME=https
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"
VITE_REVERB_ENABLED=true

# ── Aplikasi Spesifik ─────────────────────────────────────────────────────────
SUPERADMIN_EMAIL=admin@example.go.id  # [WAJIB] Email superadmin instansi
LW_WA_BROADCAST_LIMIT=50
