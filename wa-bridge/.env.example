# wa-bridge Configuration
# Salin file ini menjadi .env dan sesuaikan nilainya

# Port bridge (harus sesuai LW_WA_V2_BASE di Laravel .env)
BRIDGE_PORT=8790

# URL runtime wa-api lama
RUNTIME_URL=http://127.0.0.1:8088

# Token runtime wa-api lama (dari /var/node/wa-api/.env → TOKEN)
RUNTIME_TOKEN=e1191a9cf5e26c2f8e68d45ca66a4908

# Session ID yang aktif (dari tabel wa_session)
SESSION_ID=QG9nI8-I_DELZWCKLxcmz

# Token bridge (harus sama dengan LW_WA_V2_TOKEN di Laravel .env)
BRIDGE_TOKEN=lawangsewu2026

# URL webhook Laravel untuk menerima pesan masuk
LARAVEL_WEBHOOK_URL=https://lawangsewu.pa-semarang.go.id/wa-caraka/webhook/inbound
