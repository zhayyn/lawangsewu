# ─── WA Caraka Personal Runtime — Environment Config ────────────────────────

# Port yang digunakan runtime ini (default: 8791)
PORT=8791

# Token autentikasi untuk request dari Laravel ke runtime ini
# Harus sama dengan LW_WA_V2_TOKEN_PERSONAL di .env Laravel
API_TOKEN=ganti_dengan_token_rahasia_personal

# URL webhook Laravel (endpoint yang menerima pesan masuk)
# Gunakan IP Tailscale server Lawangsewu
# Contoh: https://lawangsewu.pa-semarang.go.id/api/wa-caraka/webhook/inbound/personal
WEBHOOK_URL=https://lawangsewu.pa-semarang.go.id/api/wa-caraka/webhook/inbound/personal

# Token yang dikirim ke Laravel webhook (harus sama dengan WA_WEBHOOK_TOKEN_PERSONAL di Laravel)
WEBHOOK_TOKEN=ganti_dengan_token_rahasia_personal

# Max history sync days
HISTORY_MAX_DAYS=30

# Log level: debug | info | warn | error
LOG_LEVEL=info

# Node environment
NODE_ENV=production
