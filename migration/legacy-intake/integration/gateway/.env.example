# Salin file ini ke gateway/.env lalu isi token rahasia

GATEWAY_APP_NAME="Lawangsewu Gateway"
GATEWAY_API_TOKEN="ganti-dengan-token-panjang-dan-acak"
GATEWAY_SSO_SHARED_SECRET="ganti-dengan-secret-sso-yang-berbeda"
GATEWAY_DB_HOST="127.0.0.1"
GATEWAY_DB_PORT="3306"
GATEWAY_DB_USER="wacaraka_app"
GATEWAY_DB_PASSWORD="ganti-password-db"
GATEWAY_DB_NAME="db_wacaraka"
GATEWAY_BUSINESS_LARAVEL_BASE_URL="http://127.0.0.1:8790"
GATEWAY_JATIDIRI_BASE_URL="http://jatidiri.lawangsewu.local"

# Base path saat aplikasi dipublish (tanpa trailing slash)
GATEWAY_BASE_PATH="/gateway"

# false = aman (dry-run deploy), true = aktif jalankan rsync deploy
GATEWAY_ALLOW_COMMANDS="false"

# Workspace kode sumber project
GATEWAY_PROJECT_ROOT="/var/www/html/lawangsewu/projects"

# Tujuan deploy lokal
GATEWAY_DEPLOY_ROOT="/var/www/html"

# Lokasi backup terenkripsi
GATEWAY_BACKUP_ROOT="/var/backups/lawangsewu"

# Prefix nama file backup dan tag cron (untuk status endpoint)
GATEWAY_BACKUP_FILE_PREFIX="lawangsewu_"
GATEWAY_BACKUP_CRON_TAG="lawangsewu"
